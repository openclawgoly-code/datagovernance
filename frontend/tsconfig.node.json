{
  "// 说明": "构建脚本(vite.config.ts)的编译配置。不再 extends @vue/tsconfig/tsconfig.node.json —— 该预设在 @vue/tsconfig 0.9 中已移除,继续引用会让整个 project reference 解析失败,并连带把 node_modules 里的类型报错一并暴露出来。这里改为自包含,配置项一目了然。",
  "include": ["vite.config.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true
  }
}
