# SuperSonic POC 配置。复制为 .env 后再启动。
SUPERSONIC_VERSION=latest
# 必须替换: openssl rand -hex 64
SUPERSONIC_JWT_SECRET=replace-me-with-openssl-rand-hex-64
# 合成数据湖目录,必须是绝对路径。容器会挂载到同一个绝对路径。
# 例: /Users/you/datagovernance/data
DG_DATA_DIR=/absolute/path/to/datagovernance/data

# DuckDB 可写目录(相对 deploy/supersonic 或绝对路径);不要放在只读 Parquet 目录里。
DG_DB_DIR=./supersonic_db

# ClickHouse POC 账号(SuperSonic 数据源使用同一口令)
CLICKHOUSE_PASSWORD=clickhouse
